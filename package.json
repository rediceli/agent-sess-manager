{
  "name": "agent-ss-mng",
  "version": "2026070500",
  "description": "Unified session management tool for OpenCode, Claude CLI, and Codex CLI",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "agent-session": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "bump-version": "bun run scripts/bump-version.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/glob": "^9.0.0",
    "typescript": "^5"
  }
}
